    "isbot": "^5.1.43",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@react-router/dev": "^7.18.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/bytes": "^3.1.5",
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.1",
